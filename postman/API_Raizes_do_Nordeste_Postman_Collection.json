      "name": "01 - Autenticação e Usuários",
      "item": [
        {
          "name": "T01 - Cadastrar cliente válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'cliente.postman.' + Date.now() + '@email.com';",
                  "pm.collectionVariables.set('cliente_email', email);",
                  "pm.collectionVariables.set('cliente_senha', '123456');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code deve ser 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Resposta deve conter id', function () { pm.expect(json.id).to.exist; });",
                  "pm.test('Perfil deve ser CLIENTE', function () { pm.expect(json.perfil).to.eql('CLIENTE'); });",
                  "pm.collectionVariables.set('cliente_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Postman\",\n  \"email\": \"{{cliente_email}}\",\n  \"telefone\": \"11999999999\",\n  \"endereco\": \"São Paulo - SP\",\n  \"senha\": \"{{cliente_senha}}\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/usuarios/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
