                  "pm.test('Resposta deve conter email do usuário logado', function () { pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('email_teste')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
