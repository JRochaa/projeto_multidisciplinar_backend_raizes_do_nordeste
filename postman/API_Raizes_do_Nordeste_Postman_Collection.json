      "item": [
        {
          "name": "T01 - Cadastrar usuário válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = 'jadson.postman.' + Date.now() + '@email.com';",
                  "pm.collectionVariables.set('email_teste', email);",
                  "pm.collectionVariables.set('senha_teste', '123456');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code deve ser 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Resposta deve conter id do cliente', function () { pm.expect(json.id).to.exist; });",
                  "pm.collectionVariables.set('cliente_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Jadson Postman\",\n  \"email\": \"{{email_teste}}\",\n  \"telefone\": \"11999999999\",\n  \"endereco\": \"S\\u00e3o Paulo - SP\",\n  \"senha\": \"{{senha_teste}}\"\n}"
            },
